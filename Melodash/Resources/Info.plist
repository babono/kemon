<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ATSApplicationFontsPath</key>
	<string>.</string>
	<key>UIAppFonts</key>
	<array>
		<string>Poppins-Medium.ttf</string>
		<string>Poppins-Bold.ttf</string>
		<string>Orbitron-Bold.ttf</string>
		<string>Poppins-Black.ttf</string>
		<string>Orbitron-Black.ttf</string>
		<string>Orbitron-Regular.ttf</string>
	</array>

	<!-- Sparkle. Melodash is distributed outside the App Store, so it has to
	     ship its own updater; without one, every user stays on whatever build
	     they happened to download. -->

	<!-- Appcast must be served over HTTPS: Sparkle authenticates the feed by
	     TLS and each update by the EdDSA signature below. -->
	<key>SUFeedURL</key>
	<string>https://www.melodash.app/appcast.xml</string>

	<!-- Public half of the EdDSA key pair. The private half lives in the
	     developer's login keychain and signs each release; Sparkle refuses any
	     update that does not verify against this value. -->
	<key>SUPublicEDKey</key>
	<string>Hz6Ps2MOVH9z/rwE4hNrbvyphxdcj9goWh7A3VMuofc=</string>

	<!-- Ask on second launch rather than deciding for the user. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
</dict>
</plist>
